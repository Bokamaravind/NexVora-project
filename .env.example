# SMTP settings (example below is for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourcompany@gmail.com
# Gmail needs an "App Password", not your normal password
SMTP_PASS=your-16-letter-app-password

# Address shown as sender (usually same as SMTP_USER)
MAIL_FROM=yourcompany@gmail.com

# Where booking notifications are delivered
COMPANY_EMAIL=hello@nexvora.com
